{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Current File (Root Context)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src:${workspaceFolder}/src/pneumonia_task:${workspaceFolder}/src/drug_sentiment"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}